# INCI Engine Environment Variables
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=obf

# Security & Tokens
JWT_SECRET=super_secret_inci_jwt_key_change_in_production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI Vision & Chat Saglayicilari
# Birincil: Groq. qwen/qwen3.8-27b gorsel girdi + json_object destekler.
# (Emekliye ayrilan llama-3.2-11b-vision-preview artik Groq hesaplarinda yok.)
AI_VISION_PROVIDER=groq # "groq" veya "gemini"
GROQ_API_KEY=gsk_... # https://console.groq.com/keys
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Ikincil yedek: Gemini. Groq cagrisi basarisiz olursa devreye girer.
GEMINI_API_KEY=AIzaSy... # Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
