# INCI Engine Environment Variables
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=obf

# Security & Tokens
JWT_SECRET=super_secret_inci_jwt_key_change_in_production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI Vision Providers (Gemini / Groq)
AI_VISION_PROVIDER=gemini # "gemini" veya "groq"
GEMINI_API_KEY=AIzaSy... # Google AI Studio (Ücretsiz)
GEMINI_MODEL=gemini-2.5-flash

# Groq Vision YEDEK sağlayıcıdır ve varsayılan olarak KAPALIDIR.
# Groq, vision modellerini sık sık kullanımdan kaldırıyor (llama-3.2-11b-vision-preview artık yok).
# Açmak için https://console.groq.com/docs/models adresinden CANLI bir vision modeli yazın:
GROQ_API_KEY=gsk_... # https://console.groq.com/keys
GROQ_VISION_MODEL= # boş bırakılırsa Groq yedeği devre dışı kalır
